# Robot Survival API — environment template. Copy to .env (never commit .env).
# In production, set these in the hosting dashboard instead of uploading a file.

# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas (user rs_api, readWrite on this database only)
MONGODB_URI=mongodb+srv://rs_api:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=RobotSurvival
MONGODB_DB_NAME=robot_survival_dev

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-96-hex-characters
JWT_EXPIRES_IN=30d

# CORS (the game does not need CORS; keep for web tools/admin pages)
CORS_ORIGIN=http://localhost:3000

# Anti-cheat — must match the scoring rules in plan Section 11.2 (combos up to x4, boss 300 pts, perks and weapons)
MAX_SCORE_PER_SECOND=250
MAX_RUN_SECONDS=3600

# AdMob server-side verification (optional, Section 16.8)
ADMOB_SSV_ENABLED=false
